# Copiá este archivo a .env y completá los valores reales.
# .env está en .gitignore: nunca se sube al repositorio.
# Usado por la implementación Express (src/app.js).

# Token que vos elegís; debe coincidir con el "Verify Token" configurado
# en Meta App Dashboard > WhatsApp > Configuration > Webhook.
WEBHOOK_VERIFY_TOKEN=changeme

# Token de acceso a la WhatsApp Business API (idealmente permanente,
# generado con un System User en Meta Business Suite).
API_TOKEN=changeme

# ID del número de teléfono de WhatsApp Business (no el número en sí).
# Meta App Dashboard > WhatsApp > API Setup.
BUSINESS_PHONE=000000000000000

# Versión de la Graph API que usa el bot.
API_VERSION=v22.0

# URL base de la Graph API.
BASE_URL=https://graph.facebook.com

# Puerto local del servidor Express.
PORT=3000
